# llm-creds.env — LLM and vision model endpoint configuration
#
# Phase 6B.158 / §11.81 (2026-08-28): single unified Qwen3.6-35B-A3B
# server on port 8093 replaces the previous split Qwen3-VL-8B (8080)
# + Qwen3.5-9B (8081) + Qwen3-VL-8B batch (8082) deployment. The new
# model handles both vision (via attached mmproj-BF16.gguf) and text
# in one process. One URL serves both VisionLLMConfig and TextLLMConfig.
#
# If llm-creds.env is absent, defaults from infra/llm_config.py are used:
#   Vision: http://127.0.0.1:8093/v1/chat/completions, model=qwen3.6, no auth
#   Text:   http://127.0.0.1:8093/v1/chat/completions, model=qwen3.6, no auth
#
# Security:
#   - This file MUST NOT be committed (it's in .gitignore).
#   - Copy this template to llm-creds.env and fill in your values.
#   - Tokens are passed as `Authorization: Bearer *** on every call.
#   - Environment variables WIN if both file and env vars are set.

# === Vision LLM (Qwen3.6 by default; can swap for any OpenAI-compatible API) ===
# Examples:
#   - Local llama-server (qwen3.6): http://127.0.0.1:8093/v1/chat/completions
#   - OpenAI:                        https://api.openai.com/v1/chat/completions
#   - Remote Ollama:                 http://192.168.1.50:11434/v1/chat/completions
#   - Anthropic (compat):            https://api.anthropic.com/v1/chat/completions
VISION_LLM_URL=http://127.0.0.1:8093/v1/chat/completions
# VISION_LLM_TOKEN=
VISION_LLM_MODEL=qwen3.6

# === Text LLM (same Qwen3.6 server by default; can swap independently of vision) ===
# Examples:
#   - Local llama-server (qwen3.6): http://127.0.0.1:8093/v1/chat/completions
#   - OpenAI:                        https://api.openai.com/v1/chat/completions
#   - Anthropic:                     https://api.anthropic.com/v1/messages
TEXT_LLM_URL=http://127.0.0.1:8093/v1/chat/completions
# TEXT_LLM_TOKEN=
TEXT_LLM_MODEL=qwen3.6