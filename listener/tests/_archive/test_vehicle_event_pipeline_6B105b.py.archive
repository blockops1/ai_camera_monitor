def vehicle_ctx(base_ctx: AlertContext) -> AlertContext:
    """Vehicle-event variant of base_ctx with known vehicles."""
    base_ctx.is_vehicle_event = True
    base_ctx.event_type = "vehicle"
    base_ctx.known_vehicles = [
