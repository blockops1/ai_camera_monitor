# telegram-creds.env — Telegram bot credentials for outbound alerts
#
# Required for any alerts to be sent. If both keys are missing, the
# listener still runs and processes webhooks (logging every event) but
# no Telegram messages are sent.
#
# Get these from @BotFather:
#   1. Message @BotFather in Telegram, run /newbot, copy the token.
#   2. Add the bot to your destination chat (channel or group).
#   3. Send any message in that chat, then visit:
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      Find the "chat":{"id": <CHAT_ID>} field in the response.
#
# This file MUST NOT be committed — it's in .gitignore.
# Copy this template to telegram-creds.env and fill in your values.

# === Telegram bot token from @BotFather ===
# Format: <bot-id>:<auth-string>
TELEGRAM_BOT_TOKEN=

# === Destination chat ID (numeric, can be negative for groups/channels) ===
# Example: -1001234567890 (channel), 123456789 (direct message)
TELEGRAM_CHAT_ID=
