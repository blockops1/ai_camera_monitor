<!--
    com.farm.surveillance.v2-cleanup.plist

    BACKUP cleanup surface. The PRIMARY cleanup mechanism is the daemon
    thread spawned in US-061c (listener daemon). This launchd agent is a
    FAIL-SAFE: if the daemon thread dies, the hourly launchd job still
    prunes expired alert directories and enforces the disk budget.

    Install (load):
        launchctl load ~/Library/LaunchAgents/com.farm.surveillance.v2-cleanup.plist

    Uninstall (unload):
        launchctl unload ~/Library/LaunchAgents/com.farm.surveillance.v2-cleanup.plist

    Kill switch:
        launchctl setenv FARMSURV_CLEANUP_DISABLED 1
        launchctl stop com.farm.surveillance.v2-cleanup
-->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.farm.surveillance.v2-cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jill/farm-surveillance-v2/.venv/bin/python</string>
        <string>-m</string>
        <string>infra.cleanup</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jill/farm-surveillance-v2</string>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FARMSURV_CLEANUP_DISABLED</key>
        <string>0</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jill/farm-surveillance-v2/logs/cleanup-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jill/farm-surveillance-v2/logs/cleanup-stderr.log</string>
</dict>
</plist>
