# Sanitized environment for farm-surveillance-v2.
#
# PRECEDENCE CHAIN (US-101z):
#   1. <repo>/.env            -- operator-owned, in-repo, mode 600 (lowest priority)
#   2. ~/.env                 -- operator-global fallback
#   3. <repo>/telegram-creds.env -- per-app creds (highest priority; always wins)
#   4. <repo>/camera-creds.env   -- per-app creds (always wins)
#   5. <repo>/llm-creds.env      -- per-app creds (always wins)
#
# Loading order is LAST-WINS for a given key. This means real tokens must
# live in per-app *-creds.env files, NOT in .env. A worker that uses
# write_file on <repo>/.env will NOT clobber real Telegram tokens, camera
# credentials, or LLM keys because the per-app creds files are loaded after
# .env and ~/.env (US-101z, 2026-10-08).
#
# WARNING: Do NOT put production tokens in <repo>/.env. Real values for
# TELEGRAM_BOT_TOKEN, TELEGRAM_HOME_CHAT_ID, camera RTSP credentials,
# and LLM keys belong in their respective *-creds.env files (mode 600).
# <repo>/.env may contain placeholder values for non-secret knobs.
# This file is committed to the repo so operators know which keys exist.

TELEGRAM_BOT_TOKEN=__paste_bot_token_here__
TELEGRAM_HOME_CHAT_ID=__paste_numeric_chat_id_here__
TELEGRAM_ALLOWED_USERS=__comma_separated_user_ids__

# ── Operator-configured night gates (added 2026-09-20) ────────────────────────
# Convention: 1=ON, 0=OFF. 1 = gate ACTIVE, 0 = gate INACTIVE.
#
# MOTION_GATE_NIGHT_SUPPRESS_ENABLED — when 1, suppresses low-confidence/low-motion
#   frames at the motion classifier layer during suntime night. (Phase 6B.116 §11.47.)
#   Set to 1 (ON) per operator 2026-09-20 — wants night motion-gate suppression active.
#   See infra/quick_classifier.py:81.
MOTION_GATE_NIGHT_SUPPRESS_ENABLED=1
#
# FARMSURV_QUIET_HOURS_ENABLED — when 1, suppresses Telegram sends during suntime
#   night for the cameras listed below. (Phase V2-062 §11.46.)
#   Set to 0 (OFF) per operator 2026-09-20 — wants to observe how the motion-gate
#   change alone affects night traffic before toggling quiet-hours. Flip to 1 when ready.
#   See infra/quiet_hours.py:86.
FARMSURV_QUIET_HOURS_ENABLED=0
#
# FARMSURV_BASELINE_OVERRIDE_ENABLED — when 1, demotes distant-vehicle threats
#   (threat_level 1 → 0) during suntime day on the cameras listed below.
#   (Phase V2-062 §11.48.) Set to 0 (OFF) per same operator directive. Flip to 1 when ready.
FARMSURV_BASELINE_OVERRIDE_ENABLED=0

# Night suppress — motion gate false-alarm suppression at night (Phase 6B.116 §11.47).
# See infra/quick_classifier.py for the three env vars consumed by NightSuppress.
MOTION_GATE_NIGHT_CONF_FLOOR=__float__
MOTION_GATE_NIGHT_BRIGHTNESS_RATIO=__float__

# Vision LLM endpoint (Qwen3-VL-8B llama-server on VM2)
VISION_LLM_URL=http://127.0.0.1:8080

# Flask daemon bind address
LISTEN_HOST=0.0.0.0

# Display timezone for Telegram alerts (IANA name). Default America/New_York
# (handles EDT/EST via DST). See listener.daemon._format_local_timestamp.
DISPLAY_TZ=America/New_York

# Gate disk-artifact retention. When truthy (1/true/yes/on), infra/gate.py
# preserves crop_*.png + frame_*.png disk paths for postmortem instead of
# deleting them after the alert pipeline finishes. Default unset = False.
# Migrated from plist to .env in US-047d — operator-direct plist cleanup
# required after this lands (see docs/PHASE-V2-047-DECISION-gate-keep-disk.md).
GATE_KEEP_DISK_ARTIFACTS=true

# --- Phase V2-062: Night-time headlight FP suppression ---

# Farm GPS coordinates (suntime twilight calculations). Required by quiet_hours
# and time_of_day modules.
FARMSURV_FARM_LAT=34.5782
FARMSURV_FARM_LON=-84.9438

# Twilight buffer in minutes (extends night-start before sunrise and night-end
# after sunset). Default 30; operator set to 0 on 2026-09-20 to switch to exact
# sunset→sunrise (no twilight buffer). Both gates and motion-gate night suppress
# read this value through infra/time_of_day.get_night_window().
FARMSURV_NIGHT_TWILIGHT_BUFFER_MIN=0

# Quiet-hours gate value is set above in the "Operator-configured night gates"
# block. Re-declaring it here would override that block. Keep all gate defaults
# consolidated above; this comment is a pointer for new operators.

# Comma-separated camera IDs for quiet hours (e.g. "cam-backyard,cam-driveway").
# Empty = all cameras.
FARMSURV_QUIET_HOURS_CAMERAS=

# Baseline-override gate value is set above in the "Operator-configured night gates"
# block. Re-declaring it here would override that block.

# Comma-separated camera IDs for baseline override. Empty = all cameras.
FARMSURV_BASELINE_OVERRIDE_CAMERAS=

# Space-separated keywords for distant-vehicle classification (used by
# quick_classifier's _is_distant_keyword match).
FARMSURV_DISTANT_KEYWORDS=***REMOVED***

# Per-camera night suppress (V2-069).
# FARMSURV_NIGHT_SUPPRESS_CAMERAS: comma-separated camera slugs to suppress
# at night. Empty = current behavior (no per-camera suppression).
# Example: OUTSIDE_BACK_SOLAR
FARMSURV_NIGHT_SUPPRESS_CAMERAS=
# FARMSURV_NIGHT_SUPPRESS_CLASSES: optional comma-separated class names to
# suppress at night. Empty = suppress all classes on listed cameras.
# Example: vehicle
FARMSURV_NIGHT_SUPPRESS_CLASSES=

# FARMSURV_GLOBAL_CHANGE_MAX_PCT (PRD V2-063, 2026-09-20).
# Suppress motion-gate alerts when EITHER per-frame diff bbox
# covers more than this percent of frame area -- treats the
# diff as global-change (IR exposure rebalance, grass in wind,
# lightning, raindrops on lens, moth on dome) rather than a
# localized subject moving. Calibration on 2026-09-20 traffic
# (24h, 1768 alerts): 6 proceeded alerts all had bbox > 60% of
# frame area; 0 proceeded alerts had 30-60% bbox. Threshold of
# 60 catches all 6 known false positives (precedent alert
# d54d3b29 on OUTSIDE_BACK_SOLAR, 67% / 86% bbox, YOLO cleared
# "car 0.59" on a parked truck) while losing zero legitimate
# alerts. Set to 0 or negative to disable.
FARMSURV_GLOBAL_CHANGE_MAX_PCT=60

# US-102y: pixel dilation applied AFTER noise-component filtering in the
# filter pipeline. 12px was tuned for 1080p; 4K H.265 may need higher.
# 12 = default (preserves current 1080p behavior). Tunable per-deploy.
FARMSV_FILTER_DILATE_PX=12  # fixed-pixel dilation after noise-component filter

# US-096c / V2-102y: min connected-component area as percent of frame.
# Filters small noise components before dilation (prevents 22px dilation
# from bridging 153 noise blobs into one giant 97%-area blob at 4K).
# 0.0005 = 0.05% of frame; floor at 50 px regardless of frame size.
MIN_AREA_PCT=0.0005  # global min CC area as percent of frame (filters noise)

# US-102y: per-cam override for MIN_AREA_PCT (4K H.265 cams need lower
# thresholds — a real truck at 4K after fragmentation produces 800-1500 px;
# the default 0.0005 * 2560*1440 = 1844 px min may filter it out).
# Format: FARMSV_{CAM_ID}_MIN_AREA_PCT (uppercase env-safe cam_id).
# FARMSV_OUTSIDE_FRONT_SOLAR_MIN_AREA_PCT=0.0001  # example: lower for 4K cam

# US-096c: per-cam override for global_change threshold.
# BACK (open garage door) shows ~70% outdoor area — NOT global-change noise.
# Set to 85.0 so the door's outdoor view doesn't trigger global_change.
BACK_GLOBAL_CHANGE_MAX_PCT=85.0  # per-cam override for BACK (open door ~70%)

# US-096c: camera IDs with open door/window. Reserved for future per-cam logic.
INSIDE_FACING_CAM_LIST=BACK  # cams with open door/window

# --- Phase V2-071: cross-diff bbox intersection (pixel-wise AND) ---
#
# BBOX_INTERSECTION_DILATE_PCT — dilation percentage applied to the
# intersection mask (AND of two diff masks) before connected-components.
# Expressed as a fraction of the smaller frame dimension:
#   0.01 = 1 percent = ~12 px on a 1296-height frame
#   0.00 = no dilation (tighter boxes, more fragments may survive)
#   0.04 = 4 percent (~52 px on a 1296-height frame — bleeds across subjects)
# Higher values merge scattered noise but risk false positives.
# Module-level default in infra/frame_diff.py DEFAULT_INTERSECTION_DILATE_PCT = 0.01.
# Operator-verified sweet spot (2026-09-22): 0.01 — 1 percent.
BBOX_INTERSECTION_DILATE_PCT=0.01

# --- Phase V2-068: MCP server ---

# MCP server enable flag. 1=ON, 0=OFF (default 0).
# When 0, the MCP server does not start. When 1, starts on FARMSURV_MCP_BIND/FARMSURV_MCP_PORT.
FARMSURV_MCP_ENABLED=1

# MCP server bind address. tailnet-only (default) binds to 100.64.0.0/10 Tailscale CGNAT range.
# Use "all" to bind 0.0.0.0 (unsafe — warns loudly at startup).
# Or set a specific interface IP like "100.64.0.2".
FARMSURV_MCP_BIND=tailnet-only

# MCP server bearer token (required when enabled). Must be 32+ characters.
# Value generated per deployment (see secrets.token_urlsafe(32)).
FARMSURV_MCP_TOKEN=__paste_32_char_token_here__

# MCP server port (default 8091).
FARMSURV_MCP_PORT=8091

# Box/server identifier exposed in MCP tool responses and healthz. Defaults to hostname.
FARMSURV_BOX_ID=***REMOVED***

# --- Phase V2-072: HTTP API server ---

# API server enable flag. 1=ON, 0=OFF (default 0).
# When 0, the API server does not start. When 1, starts on FARMSURV_API_BIND/FARMSURV_API_PORT.
FARMSURV_API_ENABLED=1

# API server bind address. tailnet-only (default) binds to 100.64.0.0/10 Tailscale CGNAT range.
# Use "all" to bind 0.0.0.0 (unsafe - warns loudly at startup).
# Or set a specific interface IP like "100.64.0.2".
FARMSURV_API_BIND=tailnet-only

# API server bearer token (required when enabled). Must be 32+ characters.
FARMSURV_API_TOKEN=__paste_32_char_token_here__

# API server port (default 8092).
FARMSURV_API_PORT=8092

# --- Phase V2-045: Animal body recognition (MegaDescriptor embedding) ---
# ANIMAL_EMBEDDER_LIVE — when 1 = ON, loads BVRA/MegaDescriptor-S-224 (~300 MB one-time download
#   to ~/.cache/huggingface/hub/) for real animal individual re-identification;
#   when 0 = OFF, returns synthetic hash-seeded 768-dim vectors (deterministic noise,
#   per-image random — not suitable for actual matching, only for unit tests).
# See infra/animal_embedder.py, scripts/enroll_animal.py, animal_matcher/match.py.
ANIMAL_EMBEDDER_LIVE=1

# --- Phase V2-059: Person body recognition (CLIP-ViT-B/32 embedding) ---
# PERSON_EMBEDDER_LIVE — when 1 = ON, loads CLIP-ViT-B/32 (~350 MB one-time download
#   to ~/.cache/huggingface/hub/) for real person individual re-identification;
#   when 0 = OFF, returns synthetic SHA256-seeded 512-dim vectors (deterministic,
#   per-path random — not suitable for actual matching, only for unit tests).
# See infra/person_embedder.py.
PERSON_EMBEDDER_LIVE=0

# --- Phase V2-073: Health heartbeat ---

# Listener periodic health heartbeat interval in seconds.  Default 600
# (10 minutes). Controls how often the HealthReporter daemon thread emits
# a structured health block to logs/daemon.log (listener + camera state).
# Set to 0 to disable the heartbeat (not recommended).
LISTENER_HEALTH_INTERVAL_SECONDS=600

# TG-on-fail: 1 = send TG summary on heartbeat FAIL, 0 = log only.
# Always fires on failure regardless of time of day. See US-092a.
LISTENER_HEALTH_TG_ON_FAIL=1  # 1 = send TG summary on heartbeat FAIL, 0 = log only

# --- Phase V2-092c: In-listener watchdog dispatcher ---

# Watchdog dispatch interval in seconds. Default 300 (5 minutes).
# The HealthReporter daemon thread fires bin/health_watchdog.sh at this cadence.
# Set to 0 to disable dispatch entirely (not recommended).
LISTENER_HEALTH_WATCHDOG_INTERVAL_SECONDS=300  # 300 = ON (5 min cadence), 0 = OFF

# Watchdog dispatch enable flag. 1 = ON (default), 0 = OFF.
# Dispatcher kill switch: when 0, the heartbeat thread never fires the watchdog
# subprocess regardless of LISTENER_HEALTH_WATCHDOG_INTERVAL_SECONDS.
# The script-level off-switch (WATCHDOG_SILENT=1) still applies independently.
LISTENER_HEALTH_WATCHDOG_ENABLED=1  # 1 = ON (dispatch fires), 0 = OFF (skip all fires)

# --- Operational watchdog (US-090, 2026-09-26) ---

# WATCHDOG_SILENT — when 1 = OFF, the watchdog exits immediately without
# running any checks or sending alerts. Use to temporarily disable alerts
# without deleting cron entries or removing the script.
WATCHDOG_SILENT=1

# WATCHDOG_LOG_INTERVAL_MIN — maximum minutes since the last daemon.log
# timestamped line before alerting. Default 15.
WATCHDOG_LOG_INTERVAL_MIN=15

# WATCHDOG_DISK_GB_WARN — data/ directory size warning threshold in GB.
# Alert when data/ exceeds this value. Default 150.
WATCHDOG_DISK_GB_WARN=150

# WATCHDOG_REMOTE_URL — Forgejo mirror URL (e.g. https://deruyter:3000/jill/farm-surveillance-v2.git)
# for drift checking. Empty = skip remote check.
WATCHDOG_REMOTE_URL=

# WATCHDOG_MAX_RESTART_ATTEMPTS -- max restart attempts for restartable failures
#   (default 3; 0 = disable retry, old single-alert behavior).
WATCHDOG_MAX_RESTART_ATTEMPTS=3

# WATCHDOG_RESTART_BACKOFF_SECONDS -- comma-separated backoff in seconds between
#   restart attempts (e.g. '30,60,120' = 3m30s total). Default '30,60,120'.
WATCHDOG_RESTART_BACKOFF_SECONDS='30,60,120'

# --- RTSP reconnect thresholds (US-098, 2026-10-03) ---

# FARMSV_RTSP_STALE_SECONDS — seconds of no frames before a reader is marked
#   unhealthy (default 20.0). 20s exceeds the OFP cam's 12s idle gap so the
#   listener rides through natural gaps without false-reconnecting.
FARMSV_RTSP_STALE_SECONDS=20.0

# FARMSV_RTSP_RECONNECT_MIN_UPTIME — minimum seconds a reader must be alive
#   before it is eligible for kill+reconnect (default 30.0).  Anti-flapping
#   guard: readers < 30s old survive even if unhealthy.
FARMSV_RTSP_RECONNECT_MIN_UPTIME=30.0
