# Sanitized environment for farm-surveillance-v2.
# Real values belong in .env (gitignored, mode 600).
# This file is committed to the repo so operators know which keys exist.

TELEGRAM_BOT_TOKEN=__paste_bot_token_here__
TELEGRAM_HOME_CHAT_ID=__paste_numeric_chat_id_here__
TELEGRAM_ALLOWED_USERS=__comma_separated_user_ids__

# ── Operator-configured night gates (added 2026-09-20) ────────────────────────
# Convention for ALL of these: 1 = gate ACTIVE (does what the variable name says),
# 0 = gate INACTIVE (the variable is a no-op). `1` and `0` both mean what you'd expect.
#
# MOTION_GATE_NIGHT_SUPPRESS_ENABLED — when 1, suppresses low-confidence/low-motion
#   frames at the motion classifier layer during suntime night. (Phase 6B.116 §11.47.)
#   Set to 1 (ON) per operator 2026-09-20 — wants night motion-gate suppression active.
#   See infra/quick_classifier.py:81.
MOTION_GATE_NIGHT_SUPPRESS_ENABLED=1
#
# FARMSURV_QUIET_HOURS_ENABLED — when 1, suppresses Telegram sends during suntime
#   night for the cameras listed below. (Phase V2-062 §11.46.)
#   Set to 0 (OFF) per operator 2026-09-20 — wants to observe how the motion-gate
#   change alone affects night traffic before toggling quiet-hours. Flip to 1 when ready.
#   See infra/quiet_hours.py:86.
FARMSURV_QUIET_HOURS_ENABLED=0
#
# FARMSURV_BASELINE_OVERRIDE_ENABLED — when 1, demotes distant-vehicle threats
#   (threat_level 1 → 0) during suntime day on the cameras listed below.
#   (Phase V2-062 §11.48.) Set to 0 (OFF) per same operator directive. Flip to 1 when ready.
FARMSURV_BASELINE_OVERRIDE_ENABLED=0

# Night suppress — motion gate false-alarm suppression at night (Phase 6B.116 §11.47).
# See infra/quick_classifier.py for the three env vars consumed by NightSuppress.
MOTION_GATE_NIGHT_CONF_FLOOR=__float__
MOTION_GATE_NIGHT_BRIGHTNESS_RATIO=__float__

# Vision LLM endpoint (Qwen3-VL-8B llama-server on VM2)
VISION_LLM_URL=http://127.0.0.1:8080

# Flask daemon bind address
LISTEN_HOST=0.0.0.0

# Display timezone for Telegram alerts (IANA name). Default America/New_York
# (handles EDT/EST via DST). See listener.daemon._format_local_timestamp.
DISPLAY_TZ=America/New_York

# Gate disk-artifact retention. When truthy (1/true/yes/on), infra/gate.py
# preserves crop_*.png + frame_*.png disk paths for postmortem instead of
# deleting them after the alert pipeline finishes. Default unset = False.
# Migrated from plist to .env in US-047d — operator-direct plist cleanup
# required after this lands (see docs/PHASE-V2-047-DECISION-gate-keep-disk.md).
GATE_KEEP_DISK_ARTIFACTS=true

# --- Phase V2-062: Night-time headlight FP suppression ---

# Farm GPS coordinates (suntime twilight calculations). Required by quiet_hours
# and time_of_day modules.
FARMSURV_FARM_LAT=34.5782
FARMSURV_FARM_LON=-84.9438

# Twilight buffer in minutes (used by quiet_hours to extend quiet hours
# before sunrise and after sunset). Default 30.
FARMSURV_NIGHT_TWILIGHT_BUFFER_MIN=30

# Quiet-hours gate value is set above in the "Operator-configured night gates"
# block. Re-declaring it here would override that block. Keep all gate defaults
# consolidated above; this comment is a pointer for new operators.

# Comma-separated camera IDs for quiet hours (e.g. "cam-backyard,cam-driveway").
# Empty = all cameras.
FARMSURV_QUIET_HOURS_CAMERAS=

# Baseline-override gate value is set above in the "Operator-configured night gates"
# block. Re-declaring it here would override that block.

# Comma-separated camera IDs for baseline override. Empty = all cameras.
FARMSURV_BASELINE_OVERRIDE_CAMERAS=

# Space-separated keywords for distant-vehicle classification (used by
# quick_classifier's _is_distant_keyword match).
FARMSURV_DISTANT_KEYWORDS=distant far away horizon
