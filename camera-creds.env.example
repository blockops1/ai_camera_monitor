# camera-creds.env — per-camera credentials
# v2 loads these at startup. File mode 600. NEVER commit values.
# Pattern: <CAM>_<FIELD> where CAM in (FRONT, BACK, OUTSIDE_FRONT_GARAGE, OUTSIDE_FRONT_POWER, OUTSIDE_FRONT_SOLAR, OUTSIDE_BACK_SOLAR)
# Fields per camera: _IP _HTTP_USER _HTTP_PASS _RTSP_USER _RTSP_PASS _RTSP_URL
#
# Example (DO NOT COMMIT real values):
FRONT_IP=
FRONT_HTTP_USER=
FRONT_HTTP_PASS=
FRONT_RTSP_USER=
FRONT_RTSP_PASS=
FRONT_RTSP_URL=

BACK_IP=
BACK_HTTP_USER=
BACK_HTTP_PASS=
BACK_RTSP_USER=
BACK_RTSP_PASS=
BACK_RTSP_URL=

OUTSIDE_FRONT_GARAGE_IP=
OUTSIDE_FRONT_GARAGE_HTTP_USER=
OUTSIDE_FRONT_GARAGE_HTTP_PASS=
OUTSIDE_FRONT_GARAGE_RTSP_USER=
OUTSIDE_FRONT_GARAGE_RTSP_PASS=
OUTSIDE_FRONT_GARAGE_RTSP_URL=

OUTSIDE_FRONT_POWER_IP=
OUTSIDE_FRONT_POWER_HTTP_USER=
OUTSIDE_FRONT_POWER_HTTP_PASS=
OUTSIDE_FRONT_POWER_RTSP_USER=
OUTSIDE_FRONT_POWER_RTSP_PASS=
OUTSIDE_FRONT_POWER_RTSP_URL=

OUTSIDE_FRONT_SOLAR_IP=
OUTSIDE_FRONT_SOLAR_HTTP_USER=
OUTSIDE_FRONT_SOLAR_HTTP_PASS=
OUTSIDE_FRONT_SOLAR_RTSP_USER=
OUTSIDE_FRONT_SOLAR_RTSP_PASS=
OUTSIDE_FRONT_SOLAR_RTSP_URL=

OUTSIDE_BACK_SOLAR_IP=
OUTSIDE_BACK_SOLAR_HTTP_USER=
OUTSIDE_BACK_SOLAR_HTTP_PASS=
OUTSIDE_BACK_SOLAR_RTSP_USER=
OUTSIDE_BACK_SOLAR_RTSP_PASS=
OUTSIDE_BACK_SOLAR_RTSP_URL=
