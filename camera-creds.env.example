# camera-creds.env.example — per-camera credentials
#
# v2 loads these at startup from `camera-creds.env` (gitignored, mode 600).
# This file is a public template showing the schema. Real values never live here.
#
# Pattern: <CAMERA_ID>_<FIELD>
# CAMERA_ID is whatever you call your camera — pick names that fit your site
# (e.g. "FRONT_GATE", "DRIVEWAY", "SIDE_YARD"). The IDs are referenced from
# `config/motion_gate_thresholds.json`.
#
# Fields per camera:
#   _IP          HTTP API host of the camera
#   _HTTP_USER   HTTP API username (often "admin" on Reolink)
#   _HTTP_PASS   HTTP API password
#   _RTSP_USER   RTSP stream username
#   _RTSP_PASS   RTSP stream password
#   _RTSP_URL    Full RTSP URL, e.g. rtsp://user:pass@192.0.2.10:554/h264Preview
#
# Example (DO NOT COMMIT real values):
CAMERA_A_IP=
CAMERA_A_HTTP_USER=
CAMERA_A_HTTP_PASS=
CAMERA_A_RTSP_USER=
CAMERA_A_RTSP_PASS=
CAMERA_A_RTSP_URL=

CAMERA_B_IP=
CAMERA_B_HTTP_USER=
CAMERA_B_HTTP_PASS=
CAMERA_B_RTSP_USER=
CAMERA_B_RTSP_PASS=
CAMERA_B_RTSP_URL=

CAMERA_C_IP=
CAMERA_C_HTTP_USER=
CAMERA_C_HTTP_PASS=
CAMERA_C_RTSP_USER=
CAMERA_C_RTSP_PASS=
CAMERA_C_RTSP_URL=
