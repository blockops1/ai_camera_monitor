# Operator-private environment for scripts/run_phase_v2_018.py.
#
# 1. Copy this file:  cp scripts/run_phase_v2_018.env.example scripts/run_phase_v2_018.env
# 2. Fill in the values below.
# 3. The .env file is gitignored. Do NOT commit it.
# 4. Source it before running:  set -a; source scripts/run_phase_v2_018.env; set +a

# Absolute path to the cloned farm-surveillance-v2 repo.
DRIVER_REPO_PATH=/absolute/path/to/farm-surveillance-v2

# Chat identifier the operator wants to receive notifications on (subscribes
# to per-story kanban updates).
OPERATOR_TELEGRAM_CHAT_ID=999999999

# Optional: daemon port the driver should treat as the live webhook listener.
# DAEMON_PORT=8090

# Optional: Hermes coder profile name to assign stories to.
# DRIVER_CODER_PROFILE=coder
