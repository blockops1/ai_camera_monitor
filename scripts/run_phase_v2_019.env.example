# scripts/run_phase_v2_019.env.example
# Copy to scripts/run_phase_v2_019.env (gitignored) and source before running the driver.

# Required: absolute path to the v2 repo
export DRIVER_REPO_PATH="/absolute/path/to/farm-surveillance-v2"

# Required: telegram chat identifier the operator should be notified on
export OPERATOR_TELEGRAM_CHAT_ID="<HOME_CHAT_ID>"

# Optional: daemon port (default 8090)
# export DAEMON_PORT=8090

# Optional: coder profile name (default 'coder')
# export DRIVER_CODER_PROFILE="coder"
