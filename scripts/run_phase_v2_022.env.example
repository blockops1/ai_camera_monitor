# scripts/run_phase_v2_022.env — operator-side env for the Telegram PRD driver.
# File mode 600. NEVER commit values.
#
# Required by run_phase_v2_022.py:
#   DRIVER_REPO_PATH          absolute path to the v2 repo on this machine
#   OPERATOR_TELEGRAM_CHAT_ID the operator's home chat identifier (read by the
#                             smoke test for verification, not by Telegram API)
#
# Required at runtime by listener/daemon.py (via ~/.env, NOT this file):
#   TELEGRAM_BOT_TOKEN        bot token from @BotFather
#   TELEGRAM_HOME_CHAT_ID     home chat identifier (NOT TELEGRAM_CHAT_ID)
#
# This file is referenced by the driver. The .env.example version is committed;
# the real .env is gitignored.

DRIVER_REPO_PATH=/Users/jill/farm-surveillance-v2
export DRIVER_REPO_PATH

OPERATOR_TELEGRAM_CHAT_ID=<HOME_CHAT_ID>
export OPERATOR_TELEGRAM_CHAT_ID
