# diagnostic output (tool-generated, not source)
.desloppify/
.qa/
quality_status.json
_ac1_verify.py

# secrets
.env
*.env
!camera-creds.env.example
!telegram-creds.env.example
!llm-creds.env.example

# privacy scanner config (operator-local identifier list)
data/private_identifiers.json

# person identity data (enrolled people — not for public repo)
data/known/people/known_people.json

# animal identity data + enrollment staging crops (biometric, not for public repo)
data/known/animals/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# alerts / frames / logs
data/frames/*
!data/frames/.gitkeep
data/tg_uploads/*
!data/tg_uploads/.gitkeep
data/debug/
logs/*.log
!logs/.gitkeep

# archives / copy-targets
/public/
/scratch/
.kanban-bodies/

# ML model weights (large binaries; release via artifacts, not source)
/models/
*.pt
*.onnx
yolov8n_static_640.onnx
*.weights
yolo*.pt

# CoreML scratch artifacts (created when scripts run ONNX through CoreML EP;
# contains compiled_model.mlmodelc + dynamic_nn shape variants — large, not source)
/[0-9]_*/        # CoreML plan-builder cache dirs left behind by /tmp scripts
/1/
/2/
/3/

# git worktrees (moved to ~/archive/v2-worktrees-YYYY-MM-DD when done)
.worktrees/
